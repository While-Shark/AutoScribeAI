    {
      "id": "status-pages-step-2",
      "workflowId": "status-pages-flow",
      "order": 2,
      "action": "设置名称 AutoScribe Demo Status 和路径 autoscribe-demo，进入状态页编辑器。",
      "location": "src/pages/AddStatusPage.vue",
      "expectedResult": "编辑器标题显示 AutoScribe Demo Status，路径显示 /status/autoscribe-demo。",
      "source": "observed",
      "evidenceIds": [
        "ev-kuma-status-editor"
      ],
      "actualResult": "编辑器标题显示 AutoScribe Demo Status，路径显示 /status/autoscribe-demo。"
    },
    {
      "id": "status-pages-step-3",
      "workflowId": "status-pages-flow",
      "order": 3,
      "action": "将 AutoScribe Demo Website 加入状态页并保存，打开公开视图确认。",
      "location": "src/pages/AddStatusPage.vue",
      "expectedResult": "公开状态页显示“所有服务运行正常”、服务分组、AutoScribe Demo Website 和 100% 在线状态。",
      "source": "observed",
      "evidenceIds": [
        "ev-kuma-status-picker",

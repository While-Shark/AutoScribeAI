      "evidenceIds": [
        "ev-kuma-notification"
      ],
      "actualResult": "渠道保存成功，通知列表出现 Demo Placeholder Webhook。未点击“测试”，未发送通知。"
    },
    {
      "id": "notifications-step-3",
      "workflowId": "notifications-flow",
      "order": 3,
      "action": "编辑 AutoScribe Demo Website，勾选 Demo Placeholder Webhook 并保存。",
      "location": "src/components/notifications",
      "expectedResult": "监控编辑页中 Demo Placeholder Webhook 复选框已勾选，页面提示已保存。",
      "source": "observed",
      "evidenceIds": [
        "ev-kuma-notification-assignment"
      ],
      "actualResult": "监控编辑页中 Demo Placeholder Webhook 复选框已勾选，页面提示已保存。"

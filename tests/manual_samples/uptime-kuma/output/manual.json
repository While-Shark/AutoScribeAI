    {
      "id": "monitoring-step-2",
      "workflowId": "monitoring-flow",
      "order": 2,
      "action": "填写名称 AutoScribe Demo Website 和 URL https://example.com，保留 60 秒检查间隔。",
      "location": "src/pages/EditMonitor.vue",
      "expectedResult": "表单使用合成名称与 example.com；保存后的监控详情显示该 URL 和 60 秒检查间隔。",
      "source": "observed",
      "evidenceIds": [
        "ev-kuma-monitor"
      ],
      "actualResult": "表单使用合成名称与 example.com；保存后的监控详情显示该 URL 和 60 秒检查间隔。"
    },
    {
      "id": "monitoring-step-3",
      "workflowId": "monitoring-flow",
      "order": 3,
      "action": "保存监控，并在仪表盘和心跳历史中核对状态。",
      "location": "src/pages/EditMonitor.vue",
      "expectedResult": "仪表盘出现 AutoScribe Demo Website；首次及后续心跳均为 HTTP 200 - OK，状态正常。",
      "source": "observed",
      "evidenceIds": [
        "ev-kuma-monitor"
      ],
      "actualResult": "仪表盘出现 AutoScribe Demo Website；首次及后续心跳均为 HTTP 200 - OK，状态正常。"
    },
    {
      "id": "notifications-step-1",
      "workflowId": "notifications-flow",
      "order": 1,
      "action": "在“设置 → 通知”中打开新增通知渠道，选择 Webhook。",
      "location": "src/components/notifications",
      "expectedResult": "通知类型列表包含 Webhook，切换后显示 Post URL、HTTP 方法和请求体字段。",
      "source": "observed",
      "evidenceIds": [
        "ev-kuma-notification"
      ],
      "actualResult": "通知类型列表包含 Webhook，切换后显示 Post URL、HTTP 方法和请求体字段。"
    },
    {
      "id": "notifications-step-2",
      "workflowId": "notifications-flow",
      "order": 2,
      "action": "填入 Demo Placeholder Webhook 与 https://example.invalid/uptime-kuma-test，并选择 application/json 请求体。",
      "location": "src/components/notifications",
      "expectedResult": "渠道保存成功，通知列表出现 Demo Placeholder Webhook。未点击“测试”，未发送通知。",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "projectVersion": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "discoveredAt": {
      "type": "string",
      "format": "date-time"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "observed",
              "source",
              "human"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "source",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "moduleId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "source": {
            "enum": [
              "observed",
              "source",
              "human"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "moduleId",
          "name",
          "roles",
          "source",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "featureId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "successCriteria": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "observed",
              "source",
              "human"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "featureId",
          "role",
          "goal",
          "preconditions",
          "successCriteria",
          "source",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "scopeItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "workflowIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "maxItems": 1000
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scope",
          "workflowIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "projectVersion",
    "scope",
    "modules",
    "features",
    "workflows",
    "scopeItems"
  ],
  "additionalProperties": false
}

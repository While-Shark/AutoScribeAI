{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectVersion": {
      "type": "string"
    },
    "manualSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coverageSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workflowCount": {
      "type": "integer",
      "minimum": 0
    },
    "verified": {
      "type": "integer",
      "minimum": 0
    },
    "blocked": {
      "type": "integer",
      "minimum": 0
    },
    "unverified": {
      "type": "integer",
      "minimum": 0
    },
    "pending": {
      "type": "integer",
      "minimum": 0
    },
    "evidenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "copiedEvidenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "ready": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "projectVersion",
    "manualSha256",
    "coverageSha256",
    "workflowCount",
    "verified",
    "blocked",
    "unverified",
    "pending",
    "evidenceCount",
    "copiedEvidenceCount",
    "ready",
    "issues"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build_demo_site.mjs",
  "outputDirectory": "demo-dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/manuals/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
